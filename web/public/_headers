# Read by Cloudflare Pages and Workers static assets.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'none'

# The closed test's sign-up page is for people with the link, not for search results.
/alpha
  X-Robots-Tag: noindex
/nl/alpha
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
