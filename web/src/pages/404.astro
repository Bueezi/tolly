---
import Base from "../layouts/Base.astro";
---

<Base lang="en" title="Page not found · Tolly" noindex>
  <section class="wrap section notfound">
    <h1 class="section-title">Page not found</h1>
    <p class="lead">Pagina niet gevonden.</p>
    <a class="btn btn-primary" href="/">Tolly</a>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    gap: 20px;
    justify-items: start;
    min-height: 50vh;
    align-content: center;
  }
</style>
