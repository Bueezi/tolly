---
// A long text page written in Markdown, such as the privacy policy. The Markdown's frontmatter
// gives its language, page path, title and description, and the date it last changed.
import Base from "./Base.astro";
import type { Lang } from "../i18n/ui";

interface Props {
  frontmatter: {
    lang: Lang;
    page: string;
    title: string;
    heading: string;
    description: string;
    updated: string;
    /** Keeps the page out of search results. */
    noindex?: boolean;
  };
}

const { lang, page, title, heading, description, updated, noindex } = Astro.props.frontmatter;
---

<Base lang={lang} page={page} title={title} description={description} noindex={noindex}>
  <article class="wrap policy">
    <header>
      <h1>{heading}</h1>
      <p class="updated">{updated}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .policy {
    max-width: 760px;
    padding-block: clamp(48px, 8vw, 96px);
  }
  header {
    display: grid;
    gap: 12px;
    padding-bottom: 32px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
  }
  .updated {
    color: var(--muted);
    font-weight: 600;
  }
  .prose {
    color: var(--muted);
  }
  .prose :global(h2) {
    color: var(--text);
    font-size: 1.45rem;
    letter-spacing: -0.025em;
    margin: 44px 0 12px;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 16px;
  }
  .prose :global(ul) {
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(li::marker) {
    color: var(--accent-text);
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--accent-text);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .prose > :global(p:first-child) {
    margin-top: 32px;
    font-size: 1.12rem;
    color: var(--text);
  }
</style>
