---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { links, otherLang, pathFor, strings, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
  /** This page in the other language. */
  alternate: string;
}

const { lang, alternate } = Astro.props;
const t = strings(lang);
const home = pathFor(lang);
---

<header class="header">
  <div class="wrap bar">
    <a class="brand" href={home} aria-label="Tolly">
      <Logo size={34} id="header-logo" />
      <span>Tolly</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href={`${home}#features`}>{t.nav.features}</a>
      <a href={`${home}#looks`}>{t.nav.looks}</a>
      <a href={`${home}#privacy`}>{t.nav.privacy}</a>
    </nav>
    <div class="actions">
      <a class="pill" href={alternate} hreflang={otherLang(lang)} lang={otherLang(lang)}>
        <span class="sr-only">{t.langSwitch.label}</span>
        <span aria-hidden="true">{t.langSwitch.short}</span>
      </a>
      <button
        class="pill icon theme-toggle"
        type="button"
        data-to-light={t.theme.toLight}
        data-to-dark={t.theme.toDark}
        aria-label={t.theme.toDark}
      >
        <Icon name="moon" size={20} class="moon" />
        <Icon name="sun" size={20} class="sun" />
      </button>
      <a class="pill icon" href={links.repo} aria-label="GitHub">
        <Icon name="github" size={20} />
      </a>
      <a class="btn btn-primary get" href={`${home}#download`}>{t.nav.download}</a>
    </div>
  </div>
</header>

<script>
  // Light/dark toggle. Without a stored choice the page follows the system; a click stores the
  // opposite of what is showing now.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(".theme-toggle")!;
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : systemDark.matches);
  const label = () => {
    button.setAttribute("aria-label", isDark() ? button.dataset.toLight! : button.dataset.toDark!);
  };
  label();
  systemDark.addEventListener("change", label);
  button.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    label();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: saturate(1.6) blur(18px);
    -webkit-backdrop-filter: saturate(1.6) blur(18px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 4px;
    margin-left: 12px;
  }
  .nav a {
    padding: 8px 14px;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding-inline: 12px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }
  .pill.icon {
    padding: 0;
    width: 40px;
  }
  .pill:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .get {
    --h: 40px;
    padding-inline: 18px;
    font-size: 0.92rem;
    margin-left: 6px;
  }

  /* The icon shows the theme you'd switch to. */
  .theme-toggle :global(.sun) {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle :global(.sun) {
    display: block;
  }
  :global(:root[data-theme="dark"]) .theme-toggle :global(.moon) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.sun) {
      display: block;
    }
    :global(:root:not([data-theme="light"])) .theme-toggle :global(.moon) {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .get {
      display: none;
    }
  }
</style>
