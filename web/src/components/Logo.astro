---
// The cap-T on its indigo gradient (brand/icon.svg), with rounded corners. `id` keeps the
// gradient's id unique when the logo appears more than once on a page.
interface Props {
  size?: number;
  id?: string;
  class?: string;
}

const { size = 32, id = "logo", class: className } = Astro.props;
const gradient = `${id}-bg`;
---

<svg class={className} width={size} height={size} viewBox="0 0 108 108" aria-hidden="true">
  <defs>
    <linearGradient id={gradient} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#5B5BF0"></stop>
      <stop offset="1" stop-color="#3B2FB8"></stop>
    </linearGradient>
  </defs>
  <rect width="108" height="108" rx="26" fill={`url(#${gradient})`}></rect>
  <g transform="translate(54 54) scale(1.25) translate(-54 -54)" fill="#fff">
    <path d="M54,26 L84,40 L54,54 L24,40 Z"></path>
    <path d="M47,47.5 L54,51 L61,47.5 L61,78 Q61,82 57,82 L51,82 Q47,82 47,78 Z"></path>
    <path
      d="M54,40 L75,44 L75,58"
      fill="none"
      stroke="#fff"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <circle cx="75" cy="61" r="3.6"></circle>
  </g>
</svg>
