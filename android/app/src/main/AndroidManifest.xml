<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A video's sound keeps playing in the background (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".TollyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tolly"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:exported="true"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Tolly.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Signed-in browser for Toledo pages; started by core/ui's openInBrowser(). -->
        <activity
            android:name=".browser.BrowserActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Tolly"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="be.tolly.action.OPEN_TOLEDO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="ultra.edu.kuleuven.cloud" />
                <data android:host="toledo.kuleuven.be" />
            </intent-filter>
        </activity>

        <!-- Video player for recordings and livestreams; started by core/ui's playVideo(). -->
        <activity
            android:name=".video.PlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask"
            android:taskAffinity="be.tolly.video"
            android:autoRemoveFromRecents="true"
            android:theme="@style/Theme.Tolly">
            <intent-filter>
                <action android:name="be.tolly.action.PLAY_VIDEO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- "Download for offline" picker; started by core/ui's openOfflineDownload(). -->
        <activity
            android:name=".offline.OfflineDownloadActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Tolly">
            <intent-filter>
                <action android:name="be.tolly.action.DOWNLOAD_OFFLINE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Tolly's own viewer for downloaded PDFs, pictures and text; started by core/ui's file events. -->
        <activity
            android:name=".viewer.FileViewerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Tolly">
            <intent-filter>
                <action android:name="be.tolly.action.VIEW_FILE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- WorkManager is initialised by TollyApplication so workers can use Hilt. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Keeps a video's sound playing in the background, with the media notification. -->
        <service
            android:name=".video.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
